# Google Cloud Platform Service Account
GCP_SERVICE_ACCOUNT={"type":"service_account",...}

# Password Protection
# Set your desired dashboard password (users will need this to access the dashboard)
DASHBOARD_PASSWORD=your-password-here

# Authentication Secret Key
# Change this to a random, secure string (used for cookie encryption)
# Generate a secure random string: https://www.random.org/strings/
AUTH_SECRET=your-very-secret-random-string-here
